# GEMINI_API_KEY: Google AI Studio automatically injects this at runtime.
# Vercel 배포 시: Vercel 대시보드 > Settings > Environment Variables에 GEMINI_API_KEY를 등록하세요.
# (Google AI Studio 내부에서는 시스템 예약어이므로 별도로 등록하지 마세요.)

# GOOGLE_SHEET_WEBHOOK_URL: 구글 스프레드시트 Apps Script 웹 앱 URL (선택 사항)
# 설정하면 참가자 신청 시 구글 시트에 실시간으로 자동 저장됩니다.
# 웹앱 화면 내 [구글 시트 연동 설정] 메뉴에서도 간편하게 등록 및 테스트할 수 있습니다.
GOOGLE_SHEET_WEBHOOK_URL="https://script.google.com/macros/s/your-deployment-id/exec"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
